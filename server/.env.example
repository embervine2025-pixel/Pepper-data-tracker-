# Copy to .env and adjust.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://pepper:pepper@127.0.0.1:5432/pepper_dev
TEST_DATABASE_URL=postgres://pepper:pepper@127.0.0.1:5432/pepper_test

# Required in production; a development fallback is used otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

# Origin the browser app is served from. Only consulted when the API and the
# frontend are on different origins; the default production setup serves both
# from this process, so CORS never comes into play.
CORS_ORIGIN=http://localhost:5173

# In production the API also serves web/dist. Set to false to run the API
# alone behind a separate static host (then CORS_ORIGIN must name that host).
# SERVE_WEB=true
# WEB_DIST_PATH=/srv/pepper/web/dist

# Managed Postgres usually requires TLS. Append ?sslmode=require to
# DATABASE_URL, or ?sslmode=no-verify if the provider uses a self-signed cert.
