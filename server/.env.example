# Copy to .env and adjust.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://pepper:pepper@127.0.0.1:5432/pepper_dev
TEST_DATABASE_URL=postgres://pepper:pepper@127.0.0.1:5432/pepper_test

# Required in production; a development fallback is used otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

# Origin the browser app is served from.
CORS_ORIGIN=http://localhost:5173
